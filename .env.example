# 任选一种免费/低成本 API，复制本文件为 .env.local 并填入 Key

# --- [1] Groq 免费（推荐试手）---
# 注册 https://console.groq.com/keys  Key 以 gsk_ 开头
# OPENAI_API_KEY=gsk-你的密钥
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# --- [2] 硅基流动 免费额度（国内）---
# 注册 https://cloud.siliconflow.cn/account/ak
# OPENAI_API_KEY=sk-你的密钥
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# OPENAI_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- [3] OpenRouter 免费模型 ---
# 注册 https://openrouter.ai/keys
# OPENAI_API_KEY=sk-你的密钥
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=google/gemma-2-9b-it:free

# --- [4] DeepSeek ---
# OPENAI_API_KEY=sk-你的密钥
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# --- [5] 通义千问 ---
